POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432

TZ=Etc/UTC
SCHEDULE=0 */6 * * *
RUN_ON_START=true

# "auto" tests the server's default gateway. Add another local router address
# when the network has a separate routed hop, for example: auto,192.168.1.1
ROUTER_TARGETS=auto,192.168.1.1
DNS_CANDIDATES=9.9.9.9,1.1.1.1,8.8.8.8

ROUTER_PING_COUNT=100
DNS_SELECTION_PING_COUNT=20
DNS_PING_COUNT=100
PING_INTERVAL_SECONDS=0.2

# Optional: pin Ookla to a known-good server ID. Empty means automatic.
SPEEDTEST_SERVER_ID=
